{
  "name": "boia-planet",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @boia/web dev",
    "build": "pnpm --filter @boia/web build",
    "start": "pnpm --filter @boia/web start",
    "e2e": "pnpm --filter @boia/web e2e",
    "test": "sh -c 'if [ \"$1\" = --filter ]; then f=$2; shift 2; set -- \"/$f/\" \"$@\"; fi; exec vitest run \"$@\"' vitest",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r --parallel typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:test": "pnpm --filter @boia/db db:test",
    "db:types": "pnpm --filter @boia/db db:types"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "15.5.26",
    "@types/node": "24.19.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  }
}
